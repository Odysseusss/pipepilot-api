# Add the real value only in Vercel Environment Variables.
STRIPE_SECRET_KEY=sk_test_replace_me

# Comma-separated browser origins allowed to call the API.
# Keep localhost entries for local Live Server testing.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://pipepilotapp.com,https://www.pipepilotapp.com

# Pipe Pilot application access. JWT signatures are verified with public JWKS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
APP_ALLOWED_ORIGINS=http://localhost:56069,https://app.pipepilotapp.com

# Existing Neon connection used by server-side routes only.
STORAGE_DATABASE_URL_UNPOOLED=postgresql://replace_in_vercel
